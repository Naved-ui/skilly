{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skilly-swap-navedui-2026",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skilly-db",
      "database_id": "892d6165-2fec-4125-9640-ca63ef98dd22",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
